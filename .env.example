# Copy this file to ".env" and fill in your real Nike ACS credentials.
# The real .env is gitignored and must NEVER be committed.
ACS_USER=your.email@company.com
ACS_PASS=your-password

# Only needed by the helper scripts extract_steps.py / parse_xaml.py:
# the folder holding the UiPath .xaml files you want to read.
XAML_FOLDER=D:\path\to\the\xaml\folder
